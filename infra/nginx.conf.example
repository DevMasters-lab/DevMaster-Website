# Adapt paths, TLS certificates, PHP-FPM socket and domain before production.
server {
    listen 443 ssl;
    server_name devmasters.example;
    root /srv/devmasters/backend/public;
    ssl_certificate /etc/letsencrypt/live/devmasters.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devmasters.example/privkey.pem;
    client_max_body_size 55m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location ~ ^/(api|sanctum|admin|livewire[^/]*)(/|$) { try_files $uri /index.php?$query_string; }
    location ~ ^/(css|js|fonts)/filament/ { try_files $uri =404; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/devmasters/backend/public/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }
    location / { proxy_pass http://127.0.0.1:3000; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; }
    location ~ /\. { deny all; }
}
