# Set before building. Browser requests use the same public origin.
LARAVEL_URL=http://127.0.0.1:8081
FRONTEND_URL=http://localhost:3000
# Vercel Production: LARAVEL_URL=https://devmasters-api.onrender.com
# Vercel Production: FRONTEND_URL=https://devmasters.dev
# Never set this to devmasters.dev (that would proxy back into Next.js).
