APP_NAME=DevMasters
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=devmaster-website
DB_USERNAME=root_postgres
DB_PASSWORD=
DB_SSLMODE=prefer
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8081
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=240
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PASSWORD=null
FILESYSTEM_DISK=private
PRIVATE_STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=devmasters-private
AWS_ENDPOINT=http://127.0.0.1:58333
AWS_USE_PATH_STYLE_ENDPOINT=true
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=51025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=noreply@devmasters.test
MAIL_FROM_NAME=DevMasters
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=53310
ALLOWED_CURRENCIES=USD,KHR
CONSENT_VERSION=development-v1

LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

APP_LOCALE=km
APP_FALLBACK_LOCALE=en
