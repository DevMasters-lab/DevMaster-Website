# Copy these values into Render Environment; never put real secrets in this file.
APP_NAME=DevMasters
APP_ENV=production
APP_DEBUG=false
APP_KEY=REPLACE_WITH_PERSISTENT_BASE64_KEY
APP_URL=https://api.devmasters.dev
FRONTEND_URL=https://website.devmasters.dev
APP_LOCALE=km
APP_FALLBACK_LOCALE=en
# The Render image defaults to *; override with known proxy IPs/CIDRs if available.
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=REPLACE_WITH_NEON_HOST
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=REPLACE_IN_RENDER_SECRETS
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_TABLE=laravel_sessions
SESSION_LIFETIME=120
SESSION_DOMAIN=.devmasters.dev
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=website.devmasters.dev,api.devmasters.dev
CACHE_STORE=database
QUEUE_CONNECTION=sync
RUN_MIGRATIONS=false

FILESYSTEM_DISK=private
PRIVATE_STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=REPLACE_IN_RENDER_SECRETS
AWS_SECRET_ACCESS_KEY=REPLACE_IN_RENDER_SECRETS
AWS_DEFAULT_REGION=REPLACE_WITH_STORAGE_AND_SES_REGION
AWS_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
# For AWS S3 omit AWS_ENDPOINT entirely; set HTTPS endpoint for compatible storage.
# AWS_ENDPOINT=https://YOUR_S3_COMPATIBLE_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
CLAMAV_HOST=REPLACE_WITH_PROTECTED_REACHABLE_SCANNER_HOST
CLAMAV_PORT=3310

# SES uses HTTPS with the installed AWS SDK; verify your sender and IAM permissions.
MAIL_MAILER=ses
MAIL_FROM_ADDRESS=noreply@devmasters.dev
MAIL_FROM_NAME=DevMasters
ALLOWED_CURRENCIES=USD,KHR
CONSENT_VERSION=REPLACE_WITH_APPROVED_CONSENT_VERSION
# PORT is supplied by Render. Do not set DB_URL or copy your local Redis/SMTP values.
